# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite file path)
DB_PATH=./data/patients.db

# Voice Platform (Vapi) Configuration
# Get your API Key and provisioned phone number at https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER=+1XXXXXXXXXX
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Public Base URL for Webhooks (Render / Railway / ngrok tunnel)
# Example: https://voice-patient-registration.up.railway.app
BASE_URL=http://localhost:3000

# Optional Webhook Security Secret
WEBHOOK_SECRET=your_webhook_secret_here
